name: Build APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: 解压工程源码
        run: |
          unzip -q astrbot-shell.zip
          ls astrbot-shell

      - name: 安装 JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: 安装 Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: 编译 APK
        run: |
          yes | sdkmanager --licenses > /dev/null 2>&1 || true
          sdkmanager "platforms;android-35" "build-tools;35.0.0" > /dev/null 2>&1 || true
          gradle -p astrbot-shell :app:assembleDebug --no-daemon --stacktrace

      - name: 收集 APK
        run: |
          mkdir -p out
          cp astrbot-shell/app/build/outputs/apk/debug/*.apk out/AstrBotShell-debug.apk
          ls -l out

      - name: 存到 Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: AstrBotShell-debug
          path: out/AstrBotShell-debug.apk

      - name: 发布 Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: build-${{ github.run_number }}
          name: AstrBotShell build ${{ github.run_number }}
          files: out/AstrBotShell-debug.apk
